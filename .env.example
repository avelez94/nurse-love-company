# Copy to .env and fill in. Never commit .env. All of these stay on the server.

# Public address of the store (used for links in emails and Stripe redirects)
APP_URL=http://localhost:5173

# Database. Leave empty in development to use the built in local database.
# Production: a PostgreSQL connection string (for example Supabase or Neon).
DATABASE_URL=

# Session signing secret. Required in production. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Stripe (test mode keys start with sk_test_). Live keys are refused unless
# LIVE_PAYMENTS_APPROVED=true is set after the owner approves launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LIVE_PAYMENTS_APPROVED=false

# Resend email
RESEND_API_KEY=
RESEND_FROM="Nurse Love Company <hello@your-verified-domain.com>"
RESEND_WEBHOOK_SECRET=

# Private file storage: local (development) or s3 (Cloudflare R2, AWS S3, Backblaze B2...)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Tutorial video: local (development) or mux (production streaming)
VIDEO_PROVIDER=local
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# Limits (megabytes)
MAX_PRODUCT_FILE_MB=200
MAX_IMAGE_MB=10
MAX_VIDEO_MB=2048
