# Copy to .env and fill in. Never commit .env. All of these stay on the server.
# DEPLOYMENT.md lists every variable and says which ones are required.

# development (default), staging or production. Staging adds a site wide
# password, blocks live payments and allows labeled demo content.
DEPLOY_ENV=development

# Public address of the store (used for sign in, links in emails and Stripe redirects)
APP_URL=http://localhost:5173

# Database. Leave empty in development to use the built in local database.
# On Vercel: Supabase's Transaction pooler connection string (port 6543).
# For npm run migrate: Supabase's Session pooler connection string (port 5432).
DATABASE_URL=
# Supabase CA certificate (PEM) so the connection is verified. Needed for Supabase.
DATABASE_SSL_CA=
# Database connections per instance (default 3 on Vercel, 10 elsewhere)
DB_POOL_MAX=

# Session signing secret. Required outside development. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Vercel Cron sends this to /api/cron/maintenance (email retries, clean up). Required on Vercel.
CRON_SECRET=

# Staging only: site wide password (at least 16 characters)
STAGING_ACCESS_USER=nurselove
STAGING_ACCESS_PASSWORD=

# Optional one time code for /#admin-setup (at least 24 characters). Remove after the first admin exists.
ADMIN_BOOTSTRAP_TOKEN=

# Staging only: allow the "Load demo content" button. Refused in production.
DEMO_CONTENT=false

# Stripe (test mode keys start with sk_test_). Live keys are always refused on
# staging, and in production only work once LIVE_PAYMENTS_APPROVED=true is set
# after the owner approves launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LIVE_PAYMENTS_APPROVED=false

# Resend email (optional; without it emails are recorded and not sent)
RESEND_API_KEY=
RESEND_FROM="Nurse Love Company <hello@your-verified-domain.com>"
RESEND_WEBHOOK_SECRET=

# Private file storage: supabase (required on Vercel), local (development) or s3 (single server).
STORAGE_DRIVER=local
# Supabase Storage. The service role key stays on the server and never reaches the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FILES_BUCKET=product-files
SUPABASE_MEDIA_BUCKET=media
# Local folder (development, or an absolute path on a persistent disk). Not used on Vercel.
LOCAL_STORAGE_DIR=.data/storage
# Obsolete for the Vercel plan (S3 compatible storage on a single long running server only).
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Tutorial video: local (stored with the other files; MP4 only on Vercel) or mux (streaming)
VIDEO_PROVIDER=local
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# Limits (megabytes). Empty means the default: 50 / 10 / 50 with Supabase (its free plan
# caps files at 50 MB), 200 / 10 / 2048 otherwise.
MAX_PRODUCT_FILE_MB=
MAX_IMAGE_MB=
MAX_VIDEO_MB=
