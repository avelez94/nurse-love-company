# Local server settings for capturing tutorial screens. Local only; never production values.
# Usage from the repo root:  . video/tools/local-server.env.example && npx tsx server/index.ts
export DATABASE_URL=postgres://nurselove:nurselove-local@localhost:5432/nlc_tutorial
export APP_URL=http://localhost:8787
export PORT=8787
export SEED_DEMO=false
export DEPLOY_ENV=development
export NODE_ENV=development
export BETTER_AUTH_SECRET=local-only-any-random-string-of-32-or-more-chars
export LOCAL_STORAGE_DIR=.data/tutorial-storage
export STORAGE_DRIVER=local
export VIDEO_PROVIDER=local
export STRIPE_SECRET_KEY=
export RESEND_API_KEY=
